 rk8xx-regulator.c |    1 -
 1 file changed, 1 deletion(-)

--- a/drivers/regulator/rk8xx-regulator.c
+++ b/drivers/regulator/rk8xx-regulator.c
@@ -614,7 +614,6 @@ static struct platform_driver rk8xx_regu
 	.probe = rk8xx_regulator_probe,
 	.driver = {
 		.name = "rk8xx-regulator",
-		.owner = THIS_MODULE,
 	},
 };
 
